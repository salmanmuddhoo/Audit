# Public URL used for canonical links, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.insight360.solutions

# --- Enquiry & interest forms (transactional email via Resend) --------------
# Create an API key at https://resend.com and verify the sending domain
# (insight360.solutions) with the DNS records Resend provides.
RESEND_API_KEY=
MAIL_FROM="Insight.360° Website <website@insight360.solutions>"
MAIL_TO=info@insight360.solutions

# --- Phased roadmap feature flags -------------------------------------------
# Stage 2: switch the Tools page from "coming soon" to the live catalogue
NEXT_PUBLIC_FEATURE_MARKETPLACE=false
# Stage 3: expose client platform entry points (login, workspace)
NEXT_PUBLIC_FEATURE_CLIENT_PLATFORM=false
